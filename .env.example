# Copy to .env and fill in. Never commit .env.

NODE_ENV=development

# API
API_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# PostgreSQL.
# Neon (cloud dev): DATABASE_URL = pooled string (host contains "-pooler"),
#   DIRECT_URL = direct string (used by Prisma migrations). Both end with ?sslmode=require.
#   DATABASE_URL_TEST = direct string (no "-pooler") of the darsi_test database: tests run migrations on it.
# Docker (infra/docker-compose.yml): set all three to postgresql://darsi:darsi@localhost:5432/<db>.
DATABASE_URL=postgresql://darsi:darsi@localhost:5432/darsi
DIRECT_URL=postgresql://darsi:darsi@localhost:5432/darsi
DATABASE_URL_TEST=postgresql://darsi:darsi@localhost:5432/darsi_test

# Redis. Upstash (cloud dev): rediss://default:<password>@<host>:6379 (note the double "s" = TLS).
REDIS_URL=redis://localhost:6379

# Auth: at least 32 random characters
JWT_SECRET=

# Seed: Telegram user id of the platform superadmin (ask @userinfobot). Optional.
SEED_SUPERADMIN_TELEGRAM_ID=

# Telegram bot (create via @BotFather)
BOT_TOKEN=
BOT_USERNAME=
# polling — the API process receives updates itself (development); off — bot disabled (tests, CI).
BOT_MODE=off
WEBHOOK_SECRET=
# Public HTTPS URL of the Mini App (cloudflared tunnel in dev: pnpm tunnel:tma)
TMA_URL=
WEB_URL=http://localhost:5173

# S3-compatible storage (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=darsi-files
S3_ACCESS_KEY=darsi
S3_SECRET_KEY=darsi-secret

# Development only: accept mocked Telegram initData. Rejected at startup when NODE_ENV=production.
AUTH_DEV_BYPASS=false

SENTRY_DSN=

# Frontends
VITE_API_URL=http://localhost:3000/api/v1
# Development only: let the Mini App run in a regular browser without Telegram initData.
VITE_DEV_MOCK_INIT_DATA=false

// Data model: TZ.md §7, ARCHITECTURE.md §3.5.
// Conventions: UUID v7 keys, snake_case tables/columns, timestamptz in UTC,
// money as BigInt in minor units, soft delete via archived_at where history matters.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations bypass connection poolers (Neon "-pooler" host); equal to DATABASE_URL without a pooler.
  directUrl = env("DIRECT_URL")
}

enum Locale {
  ru
  tg
}

enum Currency {
  TJS
  RUB
}

enum Role {
  owner
  admin
  teacher
  parent
}

enum MembershipStatus {
  invited
  active
  deactivated
}

enum SchoolStatus {
  active
  blocked
}

enum CourseFormat {
  offline
  online
}

enum CourseKind {
  group
  individual
}

enum LessonStatus {
  planned
  done
  cancelled
}

/// Course pastels, DESIGN_SYSTEM.md §1.2.
enum CourseColor {
  lime
  peach
  coral
  lavender
  mint
  butter
}

/// Darsi subscription plan: limits only, no billing in the MVP (TZ FR-6).
model Plan {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  maxStudents  Int      @map("max_students")
  maxStaff     Int      @map("max_staff")
  maxStorageMb Int      @map("max_storage_mb")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  schools School[]

  @@map("plans")
}

/// Tenant. Every business row belongs to exactly one school.
model School {
  id                   String       @id @default(uuid(7)) @db.Uuid
  name                 String
  /// Public code for the join deep link: t.me/<bot>?startapp=<code>.
  code                 String       @unique
  currency             Currency
  /// IANA zone, e.g. Asia/Dushanbe; lesson times are shown in it.
  timezone             String
  defaultLocale        Locale       @default(ru) @map("default_locale")
  /// TODO(T-34): relation to File once the files module exists.
  logoFileId           String?      @map("logo_file_id") @db.Uuid
  address              String?
  phone                String?
  description          String?
  /// Absence policy (TZ FR-8).
  chargeAbsent         Boolean      @default(true) @map("charge_absent")
  chargeExcused        Boolean      @default(false) @map("charge_excused")
  reminderHoursBefore  Int          @default(3) @map("reminder_hours_before")
  debtRemindersEnabled Boolean      @default(true) @map("debt_reminders_enabled")
  planId               String       @map("plan_id") @db.Uuid
  status               SchoolStatus @default(active)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan          Plan           @relation(fields: [planId], references: [id])
  branches      Branch[]
  memberships   Membership[]
  consents      Consent[]
  auditLogs     AuditLog[]
  inviteTokens  InviteToken[]
  courses       Course[]
  groups        Group[]
  scheduleRules ScheduleRule[]
  lessons       Lesson[]

  @@index([planId])
  @@map("schools")
}

/// One per school in the MVP; branches UI comes in v2.
model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  address   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  groups Group[]

  @@index([schoolId])
  @@map("branches")
}

/// A person, identified by their Telegram account.
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  telegramId   BigInt    @unique @map("telegram_id")
  firstName    String    @map("first_name")
  lastName     String?   @map("last_name")
  username     String?
  /// From Telegram "share contact".
  phone        String?
  locale       Locale    @default(ru)
  isSuperadmin Boolean   @default(false) @map("is_superadmin")
  /// Set when the Bot API answers 403 (TZ FR-47).
  botBlocked   Boolean   @default(false) @map("bot_blocked")
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships    Membership[]
  consents       Consent[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  createdInvites InviteToken[]

  @@map("users")
}

/// Role of a user in a school. userId stays null until the invite is accepted (T-12).
model Membership {
  id          String           @id @default(uuid(7)) @db.Uuid
  schoolId    String           @map("school_id") @db.Uuid
  userId      String?          @map("user_id") @db.Uuid
  role        Role
  displayName String           @map("display_name")
  phone       String?
  status      MembershipStatus @default(invited)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])
  inviteTokens InviteToken[]
  /// Groups this teacher membership leads.
  groups       Group[]
  /// Lessons this teacher membership gives.
  lessons      Lesson[]

  @@unique([schoolId, userId, role])
  @@index([userId])
  @@map("memberships")
}

/// One-time invite link for an invited membership (TZ FR-1, FR-10, FR-17); accepted in T-12.
model InviteToken {
  id              String    @id @default(uuid(7)) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  membershipId    String    @map("membership_id") @db.Uuid
  /// SHA-256 of the token; the token itself is shown once and never stored.
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(3)
  /// Set when a newer invite replaces this one.
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([membershipId])
  @@map("invite_tokens")
}

/// Course of a school (TZ FR-11). Deleted only while it has no groups; otherwise archived.
model Course {
  id            String       @id @default(uuid(7)) @db.Uuid
  schoolId      String       @map("school_id") @db.Uuid
  name          String
  description   String?
  format        CourseFormat
  kind          CourseKind
  ageFrom       Int?         @map("age_from")
  ageTo         Int?         @map("age_to")
  showInCatalog Boolean      @default(true) @map("show_in_catalog")
  color         CourseColor
  /// Key from COURSE_ICONS in @darsi/shared.
  icon          String
  archivedAt    DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  groups Group[]

  @@index([schoolId])
  @@map("courses")
}

/// Group of a course (TZ FR-12). Never deleted, only archived.
model Group {
  id                  String    @id @default(uuid(7)) @db.Uuid
  schoolId            String    @map("school_id") @db.Uuid
  branchId            String    @map("branch_id") @db.Uuid
  courseId            String    @map("course_id") @db.Uuid
  name                String
  teacherMembershipId String    @map("teacher_membership_id") @db.Uuid
  capacity            Int
  meetingUrl          String?   @map("meeting_url")
  startsOn            DateTime? @map("starts_on") @db.Date
  endsOn              DateTime? @map("ends_on") @db.Date
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch  Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  course  Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacher Membership @relation(fields: [teacherMembershipId], references: [id], onDelete: Restrict)

  scheduleRules ScheduleRule[]
  lessons       Lesson[]

  @@index([schoolId])
  @@index([courseId])
  @@index([teacherMembershipId])
  @@map("groups")
}

/// Weekly slot of a group (TZ FR-13). A rule that has produced lessons is closed with validTo,
/// never deleted, so past lessons keep their origin.
model ScheduleRule {
  id          String    @id @default(uuid(7)) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  /// ISO weekday: 1 — Monday, 7 — Sunday.
  weekday     Int
  /// Wall-clock 'HH:mm' in the school's time zone.
  startTime   String    @map("start_time")
  durationMin Int       @map("duration_min")
  validFrom   DateTime  @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([groupId])
  @@map("schedule_rules")
}

/// A single lesson of a group. Generated ones carry their rule; one-off ones have none (T-17).
model Lesson {
  id                  String       @id @default(uuid(7)) @db.Uuid
  schoolId            String       @map("school_id") @db.Uuid
  groupId             String       @map("group_id") @db.Uuid
  teacherMembershipId String       @map("teacher_membership_id") @db.Uuid
  startsAt            DateTime     @map("starts_at") @db.Timestamptz(3)
  durationMin         Int          @map("duration_min")
  status              LessonStatus @default(planned)
  /// Time before a reschedule; that slot stays taken for the generator.
  originalStartsAt    DateTime?    @map("original_starts_at") @db.Timestamptz(3)
  cancelReason        String?      @map("cancel_reason")
  /// Overrides the group's link.
  meetingUrl          String?      @map("meeting_url")
  scheduleRuleId      String?      @map("schedule_rule_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher      Membership    @relation(fields: [teacherMembershipId], references: [id], onDelete: Restrict)
  scheduleRule ScheduleRule? @relation(fields: [scheduleRuleId], references: [id], onDelete: SetNull)

  @@unique([groupId, startsAt])
  @@index([schoolId, startsAt])
  @@index([teacherMembershipId, startsAt])
  @@index([scheduleRuleId])
  @@map("lessons")
}

/// Personal data processing consent (TZ FR-62).
model Consent {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  policyVersion String   @map("policy_version")
  acceptedAt    DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId, policyVersion])
  @@index([schoolId])
  @@map("consents")
}

/// Rotating refresh tokens; reusing a rotated token revokes its whole family (T-07).
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Append-only change journal (TZ FR-60). schoolId is null for platform-level actions.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  entity      String
  entityId    String   @map("entity_id")
  action      String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, entity, entityId])
  @@index([schoolId, createdAt])
  @@map("audit_logs")
}

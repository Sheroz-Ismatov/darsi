{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-sample",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5500", "--directory", "design/sample"],
      "port": 5500
    },
    {
      "name": "docs",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5600", "--directory", "_site"],
      "port": 5600
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/api/dist/main.js"],
      "port": 3000
    },
    {
      "name": "api-dev-login",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.AUTH_DEV_BYPASS='true';process.env.BOT_MODE='off';require('./apps/api/dist/main.js')"
      ],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/web/node_modules/vite/bin/vite.js", "apps/web"],
      "port": 5173
    },
    {
      "name": "tma",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/tma/node_modules/vite/bin/vite.js", "apps/tma"],
      "port": 5174
    }
  ]
}
